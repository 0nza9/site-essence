# Source des donnees. Laisser vide pour utiliser la fixture locale /data/stations.json
# En production, pointer vers votre backend :
#   NEXT_PUBLIC_STATIONS_URL=https://api.exemple.fr/stations
NEXT_PUBLIC_STATIONS_URL=/data/stations.json

# Intervalle de rafraichissement en secondes (minimum 30, defaut 300)
NEXT_PUBLIC_REFRESH_INTERVAL=300
